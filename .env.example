# 阿里云百炼（DashScope）API Key：https://bailian.console.aliyun.com/ → API-KEY
DASHSCOPE_API_KEY=

# 模型：qwen-max（推荐，遵守"不编造"等约束最好）/ qwen-plus（更便宜，偶尔不太守格式）/ qwen-turbo（最便宜）
QWEN_MODEL=qwen-max

# 一般不用改
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
HOST=127.0.0.1
PORT=3000

# 每个 IP 每分钟最多请求次数，防止被刷爆 API 额度；设为 0 关闭
RATE_LIMIT_PER_MIN=10

# 单次输入最大字数
MAX_INPUT_CHARS=8000

# 设为 1 强制使用模拟输出（不调用模型，用于调试界面）
MOCK=0
